generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String        @id @default(uuid())
  systemId      String        @unique // e.g. USER-001
  name          String
  containerId   String?
  credits       Int           @default(0)
  fines         Int           @default(0)
  verifiedMass  Float         @default(0)
  transactions  Transaction[]
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  stationId   String
  scenario    String
  weight      Float
  credits     Int
  fines       Int
  timestamp   DateTime @default(now())
}
